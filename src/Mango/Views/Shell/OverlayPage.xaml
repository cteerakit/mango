<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mango.Views.Shell.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Grid x:Name="LayoutRoot">
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentColumn"
                Padding="32"
                Spacing="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <TextBlock Text="Overlay" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Choose which overlay widgets stay on screen and how the overlay behaves."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="ShowOverlayButton"
                                Content="Show overlay"
                                Click="OnShowOverlayClick" />
                            <Button
                                x:Name="HideOverlayButton"
                                Content="Hide overlay"
                                Click="OnHideOverlayClick" />
                        </StackPanel>

                        <TextBlock Text="Overlay widgets" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="PlayerToggle" Header="GPM / XPM" />
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Your GPM and XPM in the same style as the in-game HUD strip."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Timers" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Runes show a countdown shortly before they spawn."
                                TextWrapping="WrapWholeWords" />
                            <NumberBox
                                x:Name="RuneLeadNumberBox"
                                Header="Rune countdown lead time (seconds)"
                                Minimum="5"
                                Maximum="120"
                                SpinButtonPlacementMode="Inline"
                                SmallChange="1"
                                LargeChange="5" />
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="How many seconds before a rune spawns its countdown widget appears."
                                TextWrapping="WrapWholeWords" />
                            <ToggleSwitch x:Name="BountyTimerToggle" Header="Bounty rune" />
                            <ToggleSwitch x:Name="PowerTimerToggle" Header="Power rune" />
                            <ToggleSwitch x:Name="WisdomTimerToggle" Header="Wisdom rune" />
                            <ToggleSwitch x:Name="LotusTimerToggle" Header="Lotus pool" />
                        </StackPanel>

                        <Slider
                            x:Name="OpacitySlider"
                            Header="Overlay opacity"
                            Maximum="1"
                            Minimum="0.4"
                            StepFrequency="0.05" />
                        <ToggleSwitch x:Name="TurboToggle" Header="Turbo mode timers" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Widget positions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Moves every widget back to its default spot: rune countdowns along the right edge, GPM/XPM on the left."
                                TextWrapping="WrapWholeWords" />
                            <Button
                                x:Name="ResetPositionsButton"
                                Margin="0,4,0,0"
                                Content="Reset widget positions"
                                Click="OnResetPositionsClick" />
                            <TextBlock
                                x:Name="ResetPositionsStatus"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
