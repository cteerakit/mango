<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mango.Views.Shell.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <Style x:Key="FactLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FactValueStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="MatchHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MatchCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid x:Name="LayoutRoot">
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentColumn"
                Padding="32"
                Spacing="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PageTitleText" AutomationProperties.AutomationId="ProfilePageTitle" Text="Player" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Overall stats and recent matches from OpenDota."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border
                    x:Name="PickerCard"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Select player" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ComboBox
                            x:Name="PlayerPicker"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="DisplayLabel"
                            PlaceholderText="Choose a player"
                            SelectionChanged="OnPlayerPickerChanged" />
                        <TextBlock
                            x:Name="PickerEmptyText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No players yet. Connect Dota 2 GSI, or open a player from the Match page to populate this list."
                            TextWrapping="WrapWholeWords"
                            Visibility="Visible" />
                    </StackPanel>
                </Border>

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />

                <Border
                    x:Name="IdentityCard"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Identity" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FactLabelStyle}" Text="Name" />
                            <TextBlock x:Name="NameText" Grid.Row="0" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FactLabelStyle}" Text="Steam ID" />
                            <TextBlock x:Name="SteamIdText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                            <TextBlock x:Name="NoteLabel" Grid.Row="2" Style="{StaticResource FactLabelStyle}" Text="Note" />
                            <TextBlock x:Name="NoteText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                            <TextBlock x:Name="LikesLabel" Grid.Row="3" Style="{StaticResource FactLabelStyle}" Text="Likes" />
                            <TextBlock x:Name="LikesText" Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                            <TextBlock x:Name="DislikesLabel" Grid.Row="4" Style="{StaticResource FactLabelStyle}" Text="Dislikes" />
                            <TextBlock x:Name="DislikesText" Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="OverallCard"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Overall" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FactLabelStyle}" Text="Rank" />
                            <TextBlock x:Name="RankText" Grid.Row="0" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FactLabelStyle}" Text="Wins" />
                            <TextBlock x:Name="WinsText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FactLabelStyle}" Text="Losses" />
                            <TextBlock x:Name="LossesText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FactLabelStyle}" Text="Win rate" />
                            <TextBlock x:Name="WinRateText" Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                            <TextBlock Grid.Row="4" Style="{StaticResource FactLabelStyle}" Text="Total matches" />
                            <TextBlock x:Name="TotalMatchesText" Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValueStyle}" ToolTipService.ToolTip="Matches recorded by OpenDota, including Turbo" />
                            <TextBlock Grid.Row="5" Style="{StaticResource FactLabelStyle}" Text="Data source" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource FactValueStyle}"
                                Text="OpenDota public match history, including Turbo" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="MatchesCard"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Previous matches" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="MatchesEmptyText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No recent matches found."
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="RetryButton"
                            HorizontalAlignment="Left"
                            Content="Retry OpenDota"
                            Click="OnRetryClick"
                            Visibility="Collapsed" />
                        <Grid x:Name="MatchesHeaderGrid" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource MatchHeaderTextStyle}" Text="Played" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MatchHeaderTextStyle}" Text="Hero" />
                            <TextBlock Grid.Column="2" Style="{StaticResource MatchHeaderTextStyle}" Text="Result" />
                            <TextBlock Grid.Column="3" Style="{StaticResource MatchHeaderTextStyle}" Text="KDA" />
                            <TextBlock Grid.Column="4" Style="{StaticResource MatchHeaderTextStyle}" Text="Time" />
                            <TextBlock Grid.Column="5" Style="{StaticResource MatchHeaderTextStyle}" Text="Match ID" />
                        </Grid>
                        <ItemsControl x:Name="MatchesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource MatchCellTextStyle}" Text="{Binding PlayedAt}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MatchCellTextStyle}" Text="{Binding HeroName}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource MatchCellTextStyle}" Text="{Binding Result}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource MatchCellTextStyle}" Text="{Binding Kda}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource MatchCellTextStyle}" Text="{Binding Duration}" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource MatchCellTextStyle}" Text="{Binding MatchId}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
