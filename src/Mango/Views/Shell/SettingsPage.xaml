<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mango.Views.Shell.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Grid x:Name="LayoutRoot">
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentColumn"
                Padding="32"
                Spacing="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Appearance, app updates, API keys, and player-note backup."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <RadioButtons
                            x:Name="ThemeSelector"
                            Header="App theme"
                            AutomationProperties.AutomationId="ThemeSelector"
                            MaxColumns="3">
                            <RadioButton Content="Light" Tag="Light" AutomationProperties.AutomationId="ThemeLight" />
                            <RadioButton Content="Dark" Tag="Dark" AutomationProperties.AutomationId="ThemeDark" />
                            <RadioButton Content="System" Tag="System" AutomationProperties.AutomationId="ThemeSystem" />
                        </RadioButtons>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="System follows your Windows app theme. Changes are saved automatically."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="App updates" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="AppVersionText" />
                        <TextBlock
                            x:Name="AppUpdateStatus"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />
                        <Button
                            x:Name="CheckForUpdatesButton"
                            AutomationProperties.AutomationId="CheckForUpdatesButton"
                            Content="Check for updates"
                            Click="OnCheckForUpdatesClick" />
                        <Button
                            x:Name="InstallUpdateButton"
                            AutomationProperties.AutomationId="InstallUpdateButton"
                            Content="Install update and restart"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed"
                            Click="OnInstallUpdateClick" />
                        <ProgressBar
                            x:Name="UpdateProgress"
                            AutomationProperties.AutomationId="UpdateProgress"
                            Maximum="1"
                            Visibility="Collapsed" />
                        <HyperlinkButton
                            x:Name="DownloadUpdateLink"
                            AutomationProperties.AutomationId="DownloadUpdateLink"
                            Content="Download installer manually"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Steam Web API" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Used to load live teams and heroes on the Match page. Get a key from steamcommunity.com/dev/apikey."
                            TextWrapping="WrapWholeWords" />
                        <PasswordBox
                            x:Name="SteamApiKeyBox"
                            PasswordChanged="OnSteamApiKeyChanged"
                            PasswordRevealMode="Peek" />
                        <TextBlock
                            x:Name="SteamApiKeyStatus"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="STRATZ API" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Used for accurate player positions in past matches. Without a token, positions are estimated from farm. Get a token from stratz.com/api."
                            TextWrapping="WrapWholeWords" />
                        <PasswordBox
                            x:Name="StratzApiTokenBox"
                            AutomationProperties.AutomationId="StratzApiTokenBox"
                            AutomationProperties.Name="STRATZ API token"
                            PasswordChanged="OnStratzApiTokenChanged"
                            PasswordRevealMode="Peek" />
                        <TextBlock
                            x:Name="StratzApiTokenStatus"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Notes" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Export a JSON backup of player notes, or import one from another PC. Live match notes are matched by Steam ID, not player name."
                            TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="ViewNotesButton"
                                Content="View notes"
                                Click="OnViewNotesClick" />
                            <Button
                                x:Name="ImportNotesButton"
                                Content="Import notes"
                                Click="OnImportNotesClick" />
                            <Button
                                x:Name="ExportNotesButton"
                                Content="Export notes"
                                Click="OnExportNotesClick" />
                        </StackPanel>
                        <TextBlock
                            x:Name="NotesTransferStatus"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
