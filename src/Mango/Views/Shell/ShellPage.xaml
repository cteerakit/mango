<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mango.Views.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Visible"
        IsBackEnabled="False"
        IsSettingsVisible="False"
        PaneDisplayMode="Auto"
        OpenPaneLength="220"
        CompactPaneLength="48"
        CompactModeThresholdWidth="0"
        ExpandedModeThresholdWidth="1008"
        BackRequested="NavView_BackRequested"
        SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="You" Tag="you" AutomationProperties.AutomationId="NavYou">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D4;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Match" Tag="match">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7FC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Player" Tag="player">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Overlay" Tag="overlay">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7F4;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Settings" Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Shortcuts" Tag="shortcuts">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE765;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="About" Tag="about">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                Tag="status"
                Content="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                AutomationProperties.AutomationId="StatusButton"
                AutomationProperties.Name="Open status page"
                AutomationProperties.HelpText="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <FontIcon
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Glyph="&#x25CF;"
                        Foreground="{x:Bind ViewModel.ConnectionDotBrush, Mode=OneWay}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
